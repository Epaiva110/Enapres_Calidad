{
  "survey_id": "DEMO_TODOS_TIPOS_2026",
  "title": "Demostración — Todos los tipos de pregunta",
  "config": {
    "color_resaltado": "#1565C0",
    "min_caracteres_observacion": 0,
    "guardar_automatico": true,
    "mostrar_progreso": true
  },
  "paginas": [
    {
      "id_pagina": 1,
      "seccion_id": "SEC_TEXTO",
      "titulo_seccion": "Sección 1 — Texto y Números",
      "titulo": "Tipos de entrada de datos",
      "preguntas": [
        {
          "variable": "INFO_01",
          "type": "info",
          "label": "Instrucciones generales",
          "hint": "Complete todos los campos marcados con * antes de continuar.",
          "required": false
        },
        {
          "variable": "P_TEXT",
          "type": "text",
          "label": "Descripción libre",
          "hint": "Mínimo 10 caracteres, máximo 500",
          "required": true,
          "min_length": 10,
          "max_length": 500
        },
        {
          "variable": "P_NUM",
          "type": "number",
          "label": "Número entero (edad)",
          "required": true,
          "min_value": 0,
          "max_value": 120
        },
        {
          "variable": "P_DEC",
          "type": "decimal",
          "label": "Número decimal (peso en kg)",
          "required": true,
          "min_value": 0.5,
          "max_value": 300.0
        },
        {
          "variable": "P_DATE",
          "type": "date",
          "label": "Fecha de nacimiento",
          "required": true
        },
        {
          "variable": "P_TIME",
          "type": "time",
          "label": "Hora de inicio de la actividad",
          "required": true
        },
        {
          "variable": "P_DATETIME",
          "type": "datetime",
          "label": "Fecha y hora del evento",
          "required": false
        }
      ]
    },
    {
      "id_pagina": 2,
      "seccion_id": "SEC_SELECCION",
      "titulo_seccion": "Sección 2 — Selección",
      "titulo": "Preguntas de opción única y múltiple",
      "preguntas": [
        {
          "variable": "P_SINGLE",
          "type": "single",
          "label": "¿Cuál es su nivel educativo?",
          "required": true,
          "options": [
            { "value": "1", "label": "Sin educación" },
            { "value": "2", "label": "Primaria" },
            { "value": "3", "label": "Secundaria" },
            { "value": "4", "label": "Superior técnica" },
            { "value": "5", "label": "Superior universitaria" },
            {
              "value": "6",
              "label": "Otro",
              "is_other": true,
              "detail_questions": [
                {
                  "variable": "P_SINGLE_OTRO",
                  "type": "text",
                  "label": "Especifique el nivel educativo",
                  "required": true,
                  "max_length": 100
                }
              ]
            }
          ]
        },
        {
          "variable": "P_SINGLE_JUMP",
          "type": "single",
          "label": "¿Trabaja actualmente?",
          "required": true,
          "options": [
            { "value": "SI", "label": "Sí" },
            { "value": "NO", "label": "No", "jump_to_page": 3 }
          ]
        },
        {
          "variable": "P_EMPLEO_TIPO",
          "type": "single",
          "label": "Tipo de empleo",
          "required": true,
          "show_if": { "variable": "P_SINGLE_JUMP", "operator": "eq", "value": "SI" },
          "options": [
            {
              "value": "DEP", "label": "Dependiente",
              "detail_questions": [
                {
                  "variable": "P_EMPRESA",
                  "type": "text",
                  "label": "Nombre de la empresa",
                  "required": true,
                  "max_length": 200
                },
                {
                  "variable": "P_SALARIO",
                  "type": "decimal",
                  "label": "Salario mensual (S/.)",
                  "required": true,
                  "min_value": 0
                }
              ]
            },
            {
              "value": "IND", "label": "Independiente",
              "detail_questions": [
                {
                  "variable": "P_RUBRO",
                  "type": "text",
                  "label": "Rubro o actividad económica",
                  "required": true,
                  "max_length": 200
                }
              ]
            }
          ]
        },
        {
          "variable": "P_MULTIPLE",
          "type": "multiple",
          "label": "¿Qué servicios tiene en su vivienda? (puede seleccionar varios)",
          "required": true,
          "options": [
            {
              "value": "AGUA", "label": "Agua potable",
              "detail_questions": [
                {
                  "variable": "P_AGUA_HORAS",
                  "type": "number",
                  "label": "Horas de servicio al día",
                  "required": true,
                  "min_value": 1,
                  "max_value": 24
                }
              ]
            },
            { "value": "LUZ",  "label": "Electricidad" },
            { "value": "GAS",  "label": "Gas natural" },
            { "value": "INET", "label": "Internet" },
            {
              "value": "OTRO", "label": "Otro servicio", "is_other": true,
              "detail_questions": [
                {
                  "variable": "P_SERV_OTRO",
                  "type": "text",
                  "label": "Especifique el servicio",
                  "required": true
                }
              ]
            },
            { "value": "NINGUNO", "label": "Ninguno de los anteriores", "is_none": true }
          ]
        }
      ]
    },
    {
      "id_pagina": 3,
      "seccion_id": "SEC_MATRIX",
      "titulo_seccion": "Sección 3 — Matrices",
      "titulo": "Preguntas de matriz",
      "preguntas": [
        {
          "variable": "P_MATRIX",
          "type": "matrix",
          "label": "Verificación de condiciones del hogar",
          "required": true,
          "options": [
            { "variable": "PISO",    "label": "Piso de material noble" },
            { "variable": "TECHO",   "label": "Techo de material noble" },
            { "variable": "PARED",   "label": "Paredes de material noble" },
            {
              "variable": "BANO", "label": "Baño con desagüe", "is_other": true,
              "detail_questions": [
                {
                  "variable": "BANO_TIPO",
                  "type": "single",
                  "label": "Tipo de baño",
                  "required": true,
                  "show_if": { "variable": "BANO", "operator": "eq", "value": "1" },
                  "options": [
                    { "value": "IND", "label": "Baño privado" },
                    { "value": "COM", "label": "Baño compartido" }
                  ]
                }
              ]
            },
            { "variable": "AGUA_RED","label": "Agua de red pública", "disabled_if_cols": ["3"] }
          ]
        },
        {
          "variable": "P_MATRIX_SCALE",
          "type": "matrix_scale",
          "label": "Evalúe la calidad de los siguientes servicios públicos",
          "required": true,
          "scale_min": 1,
          "scale_max": 5,
          "scale_labels": ["Muy malo", "Muy bueno"],
          "options": [
            { "variable": "CAL_SALUD",  "label": "Salud pública" },
            { "variable": "CAL_EDUC",   "label": "Educación pública" },
            { "variable": "CAL_TRANSP", "label": "Transporte público" },
            { "variable": "CAL_SEGUR",  "label": "Seguridad ciudadana" }
          ]
        }
      ]
    },
    {
      "id_pagina": 4,
      "seccion_id": "SEC_ESCALAS",
      "titulo_seccion": "Sección 4 — Escalas y Valoraciones",
      "titulo": "Slider, Likert y Ranking",
      "preguntas": [
        {
          "variable": "P_SLIDER",
          "type": "slider",
          "label": "Porcentaje de satisfacción general con el servicio",
          "required": true,
          "min_value": 0,
          "max_value": 100,
          "step": 5,
          "scale_labels": ["0% — Nada satisfecho", "100% — Muy satisfecho"]
        },
        {
          "variable": "P_LIKERT_STARS",
          "type": "likert",
          "label": "Calificación general del servicio de atención",
          "required": true,
          "likert_type": "stars",
          "likert_count": 5,
          "scale_labels": ["Pésimo", "Excelente"]
        },
        {
          "variable": "P_LIKERT_EMOJI",
          "type": "likert",
          "label": "¿Cómo se siente con la atención recibida?",
          "required": true,
          "likert_type": "emoji",
          "likert_count": 5
        },
        {
          "variable": "P_RANKING",
          "type": "ranking",
          "label": "Ordene de mayor a menor prioridad los problemas de su comunidad",
          "required": true,
          "options": [
            { "value": "INSEG",   "label": "Inseguridad" },
            { "value": "BASURA",  "label": "Recojo de basura" },
            { "value": "PISTAS",  "label": "Pistas y veredas" },
            { "value": "LUZ",     "label": "Alumbrado público" },
            { "value": "PARQUES", "label": "Áreas verdes y parques" }
          ]
        }
      ]
    },
    {
      "id_pagina": 5,
      "seccion_id": "SEC_LOGICA",
      "titulo_seccion": "Sección 5 — Lógica Avanzada",
      "titulo": "Condiciones AND/OR y reglas entre variables",
      "preguntas": [
        {
          "variable": "P_EDAD_RANGO",
          "type": "single",
          "label": "Rango de edad",
          "required": true,
          "options": [
            { "value": "MENOR", "label": "Menor de 18 años" },
            { "value": "ADULTO","label": "18 a 60 años" },
            { "value": "MAYOR", "label": "Mayor de 60 años" }
          ]
        },
        {
          "variable": "P_SOLO_ADULTOS",
          "type": "single",
          "label": "¿Tiene empleo formal?",
          "required": true,
          "show_if": {
            "operator": "AND",
            "conditions": [
              { "variable": "P_EDAD_RANGO", "operator": "eq",     "value": "ADULTO" },
              { "variable": "P_SINGLE_JUMP","operator": "not_null" }
            ]
          },
          "options": [
            { "value": "SI", "label": "Sí" },
            { "value": "NO", "label": "No" }
          ]
        },
        {
          "variable": "P_MENORES_O_MAYORES",
          "type": "text",
          "label": "¿Recibe algún bono o pensión del Estado?",
          "required": false,
          "show_if": {
            "operator": "OR",
            "conditions": [
              { "variable": "P_EDAD_RANGO", "operator": "eq", "value": "MENOR" },
              { "variable": "P_EDAD_RANGO", "operator": "eq", "value": "MAYOR" }
            ]
          }
        },
        {
          "variable": "P_REGLA_CRUZADA",
          "type": "single",
          "label": "Resultado combinado — visible si nivel educativo >= 4 Y trabaja",
          "required": false,
          "show_if": {
            "operator": "AND",
            "conditions": [
              { "variable": "P_SINGLE",     "operator": "in",  "value": ["4","5"] },
              { "variable": "P_SINGLE_JUMP","operator": "eq",  "value": "SI" }
            ]
          },
          "options": [
            { "value": "A", "label": "Opción A" },
            { "value": "B", "label": "Opción B" }
          ]
        },
        {
          "variable": "P_SUMA_SERVICIOS",
          "type": "info",
          "label": "Regla de grupo: Se muestra si tiene agua Y electricidad seleccionadas",
          "show_if": {
            "operator": "AND",
            "conditions": [
              { "variable": "P_MULTIPLE", "operator": "contains", "value": "AGUA" },
              { "variable": "P_MULTIPLE", "operator": "contains", "value": "LUZ" }
            ]
          }
        }
      ]
    },
    {
      "id_pagina": 6,
      "seccion_id": "SEC_MEDIA",
      "titulo_seccion": "Sección 6 — Evidencias",
      "titulo": "GPS y Fotografías",
      "preguntas": [
        {
          "variable": "P_GPS",
          "type": "gps",
          "label": "Ubicación GPS del punto de supervisión",
          "required": true,
          "allow_skip": false,
          "allow_manual": true
        },
        {
          "variable": "P_FOTOS",
          "type": "photo",
          "label": "Fotografías de evidencia",
          "required": true,
          "max_photos": 5,
          "allow_gallery": false,
          "hint": "Tome hasta 5 fotos como evidencia"
        },
        {
          "variable": "P_RESULTADO",
          "type": "single",
          "label": "Resultado final de la supervisión",
          "required": true,
          "options": [
            { "value": "APROBADO",  "label": "✅ Aprobado" },
            { "value": "OBS",       "label": "⚠️ Con observaciones" },
            { "value": "RECHAZADO", "label": "❌ Rechazado" }
          ]
        },
        {
          "variable": "P_MOTIVO_OBS",
          "type": "text",
          "label": "Detalle las observaciones encontradas",
          "required": true,
          "min_length": 20,
          "max_length": 1000,
          "show_if": {
            "operator": "OR",
            "conditions": [
              { "variable": "P_RESULTADO", "operator": "eq", "value": "OBS" },
              { "variable": "P_RESULTADO", "operator": "eq", "value": "RECHAZADO" }
            ]
          }
        }
      ]
    }
  ]
}